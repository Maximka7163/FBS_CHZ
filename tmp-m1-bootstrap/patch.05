+    content_type = next((v for k, v in headers.items() if str(k).casefold() == "content-type"), None)
+    code: str | None = None
+    message: str | None = None
+    preview: str | None = None
+    if body:
+        lowered = (content_type or "").casefold()
+        if "json" in lowered:
+            try:
