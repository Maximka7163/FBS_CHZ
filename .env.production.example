WBCZ_ENV=production
WBCZ_DATABASE_URL=postgresql+psycopg://wbcz:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@marking-postgres:5432/wbcz
WBCZ_OWN_INN=REPLACE_WITH_VALID_10_OR_12_DIGIT_INN
WBCZ_SESSION_TTL_SECONDS=43200
WBCZ_COOKIE_SECURE=true
WBCZ_SESSION_COOKIE_NAME=wbcz_session
WBCZ_CSRF_COOKIE_NAME=wbcz_csrf
WBCZ_DEBUG=false
WBCZ_TRUSTED_HOSTS=mark.sellari.ru
WBCZ_APP_VERSION=0.5.1
WBCZ_BUILD_SHA=REPLACE_WITH_GIT_SHA
WBCZ_HEALTHCHECK_HOST=mark.sellari.ru
WBCZ_POSTGRES_DB=wbcz
WBCZ_POSTGRES_USER=wbcz
WBCZ_POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
WBCZ_BACKEND_IMAGE=sellari-marking-backend
WBCZ_BACKEND_PORT=8765

# P0 business-document organisation metadata. No real values belong in git.
# organisation_type: LEGAL_ENTITY | INDIVIDUAL_ENTREPRENEUR
WBCZ_ORGANISATION_TYPE=
WBCZ_ACTIVITY_FIAS_ID=
# Required for LEGAL_ENTITY; must stay empty for INDIVIDUAL_ENTREPRENEUR.
WBCZ_ACTIVITY_KPP=
# true | false | empty. Empty means REMOTE_SALE_RETURN must go to manual review.
WBCZ_REMOTE_SALE_RETURN_PAID=

# P0 Windows outbound agent. Disabled by default; secret is runtime-only.
WBCZ_AGENT_ENABLED=false
WBCZ_AGENT_MACHINE_TOKEN=
WBCZ_AGENT_JOB_LEASE_SECONDS=90
WBCZ_AGENT_POLL_INITIAL_SECONDS=10
WBCZ_AGENT_POLL_MAX_SECONDS=120
WBCZ_AGENT_POLL_MAX_ATTEMPTS=60

# Must remain false until separate runtime contract acceptance.
WBCZ_TRUE_API_WRITE_ENABLED=false


# M15 strict production runtime. These are placeholders/paths only; real
# credentials and key material do not belong in this file or git.
WBCZ_M15_STRICT_PRODUCTION=true
WBCZ_PROCESS_ROLE=web
WBCZ_APP_URL=https://mark.sellari.ru
# Runtime URL MUST authenticate as wbcz_app. Deployment tooling supplies the
# separate wbcz_migrator URL only to the one-shot migration process.
WBCZ_DATABASE_URL=postgresql+psycopg://wbcz_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@marking-postgres:5432/wbcz
WBCZ_MIGRATION_DATABASE_URL=postgresql+psycopg://wbcz_migrator:REPLACE_WITH_URL_ENCODED_MIGRATOR_PASSWORD@marking-postgres:5432/wbcz
WBCZ_TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12
WBCZ_DB_POOL_SIZE=5
WBCZ_DB_MAX_OVERFLOW=5
WBCZ_DB_POOL_TIMEOUT_SECONDS=30
WBCZ_DB_POOL_RECYCLE_SECONDS=1800
WBCZ_DB_STATEMENT_TIMEOUT_MS=30000
WBCZ_DB_LOCK_TIMEOUT_MS=5000
WBCZ_DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
WBCZ_DB_APPLICATION_NAME=wbcz-web
WBCZ_WORKER_CONCURRENCY=1
WBCZ_WORKER_HEARTBEAT_SECONDS=15
WBCZ_WORKER_STALE_SECONDS=90
WBCZ_WORKER_LEASE_SECONDS=120
WBCZ_SCHEDULER_INTERVAL_SECONDS=30
WBCZ_SCHEDULER_MAX_AGE_SECONDS=86400
WBCZ_REPORT_ARTIFACT_ROOT=/var/lib/wbcz/artifacts
WBCZ_REPORT_TEMP_ROOT=/var/lib/wbcz/tmp
WBCZ_SECRET_PROVIDER_ROOT=/var/lib/wbcz/secret-store
WBCZ_SECRET_PROVIDER_MASTER_KEY_PATH=/run/wbcz-keys/secret-master.key
WBCZ_ARTIFACT_KEYRING_ROOT=/run/wbcz-keys/artifacts
WBCZ_REPORT_ARTIFACT_KEY_VERSION=REPLACE_WITH_KEY_VERSION_ID
WBCZ_AUDIT_KEY_PATH=/run/wbcz-keys/audit/current.key
WBCZ_AUDIT_PSEUDONYM_KEY_ID=REPLACE_WITH_AUDIT_KEY_VERSION_ID
WBCZ_BACKUP_STATUS_PATH=/run/wbcz-status/backup-status.json
WBCZ_NORMAL_JSON_BODY_LIMIT_BYTES=1048576
WBCZ_MAX_ACTIVE_SESSIONS_PER_USER=10
WBCZ_AGENT_ENROLLMENT_TTL_SECONDS=600
WBCZ_AGENT_PROTOCOL_CURRENT=m15-v1
WBCZ_AGENT_PROTOCOL_MINIMUM=m14-v1
WBCZ_AGENT_MINIMUM_VERSION=0.5.1

# PostgreSQL bootstrap-only role passwords for initial DB creation. Store these
# outside git and remove bootstrap superuser credentials from ordinary runtime.
WBCZ_POSTGRES_SUPERUSER=postgres
WBCZ_POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_LONG_RANDOM_BOOTSTRAP_SECRET
WBCZ_APP_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_APP_SECRET
WBCZ_MIGRATOR_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_MIGRATOR_SECRET
WBCZ_BACKUP_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_BACKUP_SECRET

# Local printing foundation. Physical execution and remote FULL-KM acquisition remain disabled.
WBCZ_PRINTING_ENABLED=false
WBCZ_PRINT_EXECUTION_ENABLED=false
WBCZ_SUZ_FULL_KM_REMOTE_ACQUISITION_ENABLED=false
WBCZ_SUZ_KM_KEYRING_ROOT=/run/keys/suz-km

# Phase-A sensitive printing delivery policy. Production execution remains disabled.
WBCZ_PRINT_DELIVERY_RESERVATION_TTL_SECONDS=600
WBCZ_PRINT_DELIVERY_MAX_ISSUANCE=3
WBCZ_PRINT_KEY_INTENT_TTL_SECONDS=600
WBCZ_MAX_PRINT_DELIVERY_VAULT_ENTRY_BYTES=8388608
