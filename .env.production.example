WBCZ_ENV=production
WBCZ_DATABASE_URL=postgresql+psycopg://wbcz:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@marking-postgres:5432/wbcz
WBCZ_OWN_INN=REPLACE_WITH_VALID_10_OR_12_DIGIT_INN
WBCZ_SESSION_TTL_SECONDS=43200
WBCZ_COOKIE_SECURE=true
WBCZ_SESSION_COOKIE_NAME=wbcz_session
WBCZ_CSRF_COOKIE_NAME=wbcz_csrf
WBCZ_DEBUG=false
WBCZ_TRUSTED_HOSTS=mark.sellari.ru
WBCZ_APP_VERSION=0.5.1
WBCZ_BUILD_SHA=REPLACE_WITH_GIT_SHA
WBCZ_HEALTHCHECK_HOST=mark.sellari.ru
WBCZ_POSTGRES_DB=wbcz
WBCZ_POSTGRES_USER=wbcz
WBCZ_POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
WBCZ_BACKEND_IMAGE=sellari-marking-backend
WBCZ_BACKEND_PORT=8765

# P0 Windows outbound agent. Disabled by default; secret is runtime-only.
WBCZ_AGENT_ENABLED=false
WBCZ_AGENT_MACHINE_TOKEN=
WBCZ_AGENT_JOB_LEASE_SECONDS=90
WBCZ_AGENT_POLL_INITIAL_SECONDS=10
WBCZ_AGENT_POLL_MAX_SECONDS=120
WBCZ_AGENT_POLL_MAX_ATTEMPTS=60

# Must remain false until separate runtime contract acceptance.
WBCZ_TRUE_API_WRITE_ENABLED=false
