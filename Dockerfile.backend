FROM python:3.12-slim AS builder
WORKDIR /build
COPY pyproject.toml ./
COPY src ./src
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip wheel --no-cache-dir --wheel-dir /wheels ".[web]"

FROM python:3.12-slim AS runtime
ARG APP_VERSION=0.5.1
ARG BUILD_SHA=dev
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    WBCZ_APP_VERSION=${APP_VERSION} \
    WBCZ_BUILD_SHA=${BUILD_SHA}
RUN groupadd --system wbcz \
    && useradd --system --gid wbcz --create-home --home-dir /home/wbcz wbcz
COPY --from=builder /wheels /wheels
RUN python -m pip install --no-cache-dir /wheels/*.whl \
    && rm -rf /wheels
WORKDIR /app
COPY alembic.ini ./alembic.ini
COPY migrations ./migrations
# COPY preserves source modes from the build context. Normalize Alembic assets in
# the image so the unprivileged runtime user can always read/traverse them even
# when the extracted production build context had restrictive permissions.
RUN chmod 0755 /app \
    && find /app/migrations -type d -exec chmod 0755 {} + \
    && find /app/migrations -type f -exec chmod 0644 {} + \
    && chmod 0644 /app/alembic.ini \
    && chown -R root:root /app/alembic.ini /app/migrations
USER wbcz
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["python","-c","import os,urllib.request; req=urllib.request.Request('http://127.0.0.1:8765/api/health',headers={'Host':os.environ.get('WBCZ_HEALTHCHECK_HOST','localhost')}); r=urllib.request.urlopen(req,timeout=3); raise SystemExit(0 if r.status == 200 else 1)"]
CMD ["uvicorn","wbcz_web.main:app","--host","0.0.0.0","--port","8765","--workers","2","--no-access-log"]
